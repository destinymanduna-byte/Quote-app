@app.post("/api/paynow/init")
def paynow_init(user_id: str, tier: str, email: str = "customer@anrevaz.zw"):
    if tier not in SUBSCRIPTIONS:
        raise HTTPException(400, "Invalid tier")
    amount = SUBSCRIPTIONS[tier]["price"]
    reference = f"ANREVAZ-{tier}-{user_id}-{uuid.uuid4().hex[:6].upper()}"
    return_url = f"https://yourapp.up.railway.app/payment/success?reference={reference}"
    result_url = f"https://yourapp.up.railway.app/api/paynow/result"
    data = {
        "id": PAYNOW_ID,
        "reference": reference,
        "amount": f"{amount:.2f}",
        "additionalinfo": f"ANREVAZ OS {tier} Monthly Prepaid",
        "returnurl": return_url,
        "resulturl": result_url,
        "authemail": email,
        "status": "Message"
    }
    data["hash"] = create_paynow_hash(data, PAYNOW_KEY)
    try:
        r = requests.post(PAYNOW_INIT_URL, data=data, timeout=30)
        parsed = urllib.parse.parse_qs(r.text)
        browser_url = parsed.get("browserurl", [""])[0]
        poll_url = parsed.get("pollurl", [""])[0]
        status = parsed.get("status", [""])[0]
        if status != "Ok" or not poll_url:
            return {"error": "Paynow init failed", "raw": r.text}
        users_entitlement[user_id] = {
            "tier": tier,
            "reference": reference,
            "poll_url": poll_url,
            "browser_url": browser_url,
            "amount": amount,
            "status": "PENDING",
            "created_at": datetime.now().isoformat()
        }
        return {
            "status": "PENDING",
            "reference": reference,
            "tier": tier,
            "amount": amount,
            "browser_url": browser_url,
            "poll_url": poll_url,
            "message": f"Pay ${amount} via EcoCash - Opening Paynow..."
        }
    except Exception as e:
        raise HTTPException(500, f"Paynow error: {str(e)}")

@app.get("/api/paynow/poll/{reference}")
def paynow_poll(reference: str):
    user_id = None
    poll_url = None
    for uid, ent in users_entitlement.items():
        if ent.get("reference") == reference:
            user_id = uid
            poll_url = ent.get("poll_url")
            break
    if not poll_url:
        raise HTTPException(404, "Reference not found")
    try:
        r = requests.get(poll_url, timeout=30)
        parsed = urllib.parse.parse_qs(r.text)
        status = parsed.get("status", [""])[0]
        amount = parsed.get("amount", ["0"])[0]
        paynow_ref = parsed.get("paynowreference", [""])[0]
        if status.lower() == "paid":
            tier = users_entitlement[user_id]["tier"]
            expires = datetime.now() + timedelta(days=SUBSCRIPTIONS[tier]["days"])
            users_entitlement[user_id].update({
                "tier": tier,
                "status": "ACTIVE",
                "expires_at": expires.isoformat(),
                "paid_at": datetime.now().isoformat(),
                "paynow_reference": paynow_ref,
                "amount_paid": amount,
                "verified_via": "poll_url",
                "monthly_prepaid": True
            })
            return {
                "status": "PAID_VERIFIED",
                "reference": reference,
                "paynow_reference": paynow_ref,
                "tier": tier,
                "expires_at": expires.isoformat(),
                "days": SUBSCRIPTIONS[tier]["days"],
                "amount": amount,
                "verification_method": "poll_url SECURE",
                "message": f"Payment verified via poll_url! {tier} active until {expires.date()}",
                "eco_cash_only": ECOCASH_ONLY,
                "whatsapp_proof_only": WHATSAPP_ONLY
            }
        elif status.lower() in ["cancelled", "failed"]:
            users_entitlement[user_id]["status"] = "FAILED"
            return {"status": status, "message": "Payment cancelled/failed"}
        else:
            return {"status": status or "PENDING", "message": "Awaiting payment...", "poll_again_in": "5 seconds"}
    except Exception as e:
        raise HTTPException(500, f"Poll error: {str(e)}")

@app.post("/api/paynow/result")
async def paynow_result(request: Request):
    body = await request.body()
    parsed = urllib.parse.parse_qs(body.decode())
    reference = parsed.get("reference", [""])[0]
    if reference:
        return paynow_poll(reference)
    return {"status":"received"}

